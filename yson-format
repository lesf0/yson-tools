#!/bin/bash

set -euo pipefail

if [ $# -ne 1 ]; then
    echo "yson-format error: expected single argument" >&2
    exit 1
fi

# -o only opens the file once the input has been read and formatted, so naming
# the input file here is safe: no temporary file, and the file keeps its inode
# and permissions. Errors (missing file, unreadable, unparseable) come from
# yson-convert and leave the file alone.
exec yson-convert -m pretty -i "$1" -o "$1"
